{
  "name": "Fillo — מילוי וחתימה על טפסים",
  "short_name": "Fillo",
  "description": "כל טופס, מלא וחתום בשניות — בעברית, בלי הדפסה ובלי סריקה.",
  "lang": "he",
  "dir": "rtl",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0E2A52",
  "theme_color": "#0E2A52",
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "pdf", "accept": ["application/pdf", ".pdf"] }
      ]
    }
  }
}
